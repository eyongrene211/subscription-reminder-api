# Application Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/subscription_reminder_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=subscription_reminder_db

# Email Service Configuration (defaults to console logger)
EMAIL_SERVICE=console
EMAIL_FROM=no-reply@subreminder.com
